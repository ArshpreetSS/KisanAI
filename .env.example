# Kisan AI Environment Configuration
PORT=3000

# ==============================================================
# Supabase Authentication & Database Configuration (Email OTP)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ==============================================================
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Publishable / Anon Key (Safe for frontend client use)
SUPABASE_PUBLISHABLE_KEY=

# (Optional for server-side elevated admin checks only - NEVER expose on frontend)
# SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Optional for production live AI generation)
# Get a free key at: https://aistudio.google.com/
# If left blank, Kisan AI operates in Verified Regional Agromet & Pathology Mode
GEMINI_API_KEY=

# Default Farm Coordinates (Sirhind / Fatehgarh Sahib, Punjab, India)
DEFAULT_LAT=30.6433
DEFAULT_LON=76.3887

# SMS Gateway Configuration (Optional - logs to server console if unset)
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
